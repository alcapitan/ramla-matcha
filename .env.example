# Copie ce fichier en ".env" et remplis les valeurs.

# Adresse publique du site (utilisée dans les e-mails)
SITE_URL=https://ramlamatcha.com

# Mot de passe de la page /admin (liste des commandes)
ADMIN_PASSWORD=change-moi-par-un-long-mot-de-passe

# E-mail où tu reçois chaque nouvelle commande
OWNER_EMAIL=ton.email@gmail.com

# Envoi des e-mails (code -15% + notification commande)
# Exemple Gmail : active la validation en 2 étapes puis crée un "mot de passe d'application"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ton.email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=Ramla Matcha <ton.email@gmail.com>
